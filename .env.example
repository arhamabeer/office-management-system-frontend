# Leave NEXT_PUBLIC_API_URL empty to use the same-origin proxy (recommended in dev):
# the browser calls /api/* on the web origin and Next forwards it to BACKEND_ORIGIN,
# keeping the httpOnly refresh cookie first-party. Set it only for a separately-hosted API.
NEXT_PUBLIC_API_URL=

# Backend origin the dev proxy forwards /api/* to.
BACKEND_ORIGIN=http://localhost:4000
